# Spacing rules for this repo. Most editors read this file (nvim does by default).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{lua,json,yml,yaml,tex}]
indent_size = 2

[{Makefile,*.mk,.vimrc,bin/bin/*,**/coc-settings.json}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Generated by tools: leave as they write them.
[{zsh/.p10k.zsh,nix/flake.lock,karabiner/**.json,coc/.config/coc/extensions/**,**/lazy-lock.json}]
trim_trailing_whitespace = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
