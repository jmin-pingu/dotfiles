should_launch_new_window 1
sort_bookmarks_by_location 1
font_size 24
ui_font MesloLGM Nerd Font

# Highlight colors (R G B, 0-1). Muted to match y; unset letters use Sioyek's bright defaults.
text_highlight_color 0.75 0.77 0.86
highlight_color_y 0.92 0.75 0.33
highlight_color_g 0.56 0.78 0.47
highlight_color_r 0.91 0.49 0.45
highlight_color_b 0.45 0.65 0.90
highlight_color_t 0.40 0.78 0.75
highlight_color_h 0.95 0.80 0.62
highlight_color_j 0.60 0.85 0.68
highlight_color_f 0.35 0.60 0.42
shared_database_path /Users/jmin/.sioyek.db

smooth_scroll_speed 3
smooth_scroll_drag 3000
