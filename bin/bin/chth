#!/bin/bash

THEMES=(
	"twilight:twilight256,min-default"
	"nord:nord,nord"
	"neon:rdark-terminal2,electron-highlighter"
	"habamax:habamax,iTerm2 Tango Dark"
	"teen-titans:minimalist,vesper"
	"depression:mies,Apple Classic"
)
	
# first check for -themes option
for argv in "$@"; do
	if [[ $argv = "-themes" ]]; then
		echo "Themes:"
		for theme in "${THEMES[@]}" ; do
			echo -e '\t'$theme
		done
		exit 0
	fi
done

# otherwise, ensure that there is only one argument
if [[ $# -ne 1 ]]; then
	echo "error: usage chth [theme]"
	echo "use -themes to list available themes"
	exit 1	
fi

FOUND=0
for theme in "${THEMES[@]}" ; do
    KEY=${theme%%:*}
	if [[ "$KEY" = "$1" ]]; then
    	VALUE=${theme#*:}
		FOUND=1
		break
	fi
done

if [[ $FOUND = 0 ]]; then
	echo "error: theme \"$1\" not found"
	echo "use -themes to list available themes"
	exit 1
fi

# proceed as usual
VIM_THEME=${VALUE%%,*}
GHOSTTY_THEME=${VALUE#*,}

# Edit the real files: these are stow symlinks, and sed -i won't edit a symlink.
VIMRC=$(readlink -f ~/.vimrc)
GHOSTTY_CONFIG=$(readlink -f ~/.config/ghostty/config)

# -i.bak works with both BSD (macOS) and GNU sed; drop the backup after.
sed -i.bak "s/^colorscheme .*/colorscheme $VIM_THEME/" "$VIMRC" && rm "$VIMRC.bak"
sed -i.bak "s/^theme *=.*/theme =\"$GHOSTTY_THEME\"/" "$GHOSTTY_CONFIG" && rm "$GHOSTTY_CONFIG.bak"

# double-check ghostty config is working appropriately
ghostty +validate-config

echo "vim-theme: $VIM_THEME, ghostty-theme: $GHOSTTY_THEME"
echo "make sure to refresh ghostty: [CMD+SHIFT+,]"

